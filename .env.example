# =============================================
# HIỂU UYÊN BOT - ENVIRONMENT CONFIGURATION
# =============================================
# Copy file này thành .env và điền thông tin của bạn

# Discord Bot Token (lấy từ https://discord.com/developers)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID
CLIENT_ID=your_client_id_here

# GUILD_ID không cần nữa!
# Bot tự động deploy commands vào mọi server khi được add vào 🎉

# =============================================
# DATABASE CONFIG
# =============================================
DB_PATH=./data/hieu-uyen.db

# =============================================
# WEB DASHBOARD CONFIG
# =============================================
WEB_PORT=3000
WEB_SECRET=your_super_secret_key_here

# =============================================
# BOT CONFIG
# =============================================
# ID của channel để bot log hoạt động
LOG_CHANNEL_ID=your_log_channel_id
DIARY_CHANNEL_ID=your_diary_channel_id
HEALTH_CHANNEL_ID=your_health_channel_id

# XP settings
XP_PER_MESSAGE=5
XP_COOLDOWN_SECONDS=60
XP_VOICE_PER_MINUTE=2

# Daily reward amount
DAILY_COINS=100
DAILY_XP=50

# =============================================
# AI CHAT CONFIG (OpenAI-compatible)
# =============================================
# Lấy key tại https://z.ai — GLM-4.5-Flash có bản miễn phí
# Không commit key thật lên git.
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.z.ai/api/paas/v4
AI_MODEL=glm-4.5-flash
